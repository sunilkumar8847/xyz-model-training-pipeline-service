# ================================================================
# Model Training Pipeline Service — Local Secrets
# .env.local  (git-ignored)
# ================================================================

ENVIRONMENT=development
LOG_LEVEL=DEBUG

# PostgreSQL — shared platform infra (host 5442; native Windows pg holds 5432)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5442
POSTGRES_PASSWORD=xyzmdm_local_secret


# AWS LocalStack credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ================================================================
# LOCAL_DEV execution profile — XGBoost-only (Windows, 16GB, RTX 3050)
#
# This laptop cannot train BERT + a real GNN alongside XGBoost. Only XGBoost
# is trained here. The other two are NOT faked: they are reported as
# not-trained and excluded from the ensemble (see ENABLED_TRAINERS).
#
# Production (Profile B) overrides all of these — see .env.prd.
# ================================================================

# Train XGBoost only. Production value is "transformer,gnn,xgboost".
ENABLED_TRAINERS=xgboost

# SYNTHETIC development labels — generate with, from the repository root:
#     python -m synthetic_data --profile dev
# NOT production data. Permitted only when ENVIRONMENT is development or test; the
# service refuses to start if this is set in staging/production.
#
# NOTE: the default FEATURE_STORE_RETRIEVAL_MODE=offline needs these synthetic
# entities' features MATERIALIZED in the Feature Store's offline store. No synthetic
# materializer exists yet (planned with the Phase 2 data-provider work), so an
# offline run fails with FeatureCoverageError. Until then, a local run can opt into
# FEATURE_STORE_RETRIEVAL_MODE=online, which computes features on the fly from this
# dataset's entities.parquet (not point-in-time).
#
# DEMO_DATA_DIR is no longer supported and is rejected at startup.
SYNTHETIC_DATA_DIR=D:/OSN DevNet/synthetic_data/output/dev

# Feature Store running locally from its own .venv
FEATURE_STORE_URL=http://127.0.0.1:8115
FEATURE_STORE_RETRIEVAL_MODE=offline
FEATURE_CATALOG_VERSION=v2.0.0

# MLflow: the `mlflow server` CLI is broken on Python 3.12
# (entry_points().get removed), so the client talks to SQLite directly.
# Registry works because SQLite is a database-backed store.
# Production uses an MLflow server + S3 artifacts.
MLFLOW_TRACKING_URI=sqlite:///D:/OSN DevNet/.local-mlflow/mlflow.db
MLFLOW_ARTIFACT_LOCATION=file:///D:/OSN DevNet/.local-mlflow/artifacts

# Training DB lives in the shared infra postgres
POSTGRES_DB=xyzmdm
