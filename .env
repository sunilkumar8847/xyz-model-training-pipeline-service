# ─── Service Identity ─────────────────────────────────────────────────────────
SERVICE_NAME=model-training-pipeline
SERVICE_VERSION=3.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8007
API_WORKERS=1

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
POSTGRES_DB=model_training
POSTGRES_USER=training_user
POSTGRES_PASSWORD=training_pass

# ─── MLflow ───────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=xyz-mdm-matching
MLFLOW_ARTIFACT_LOCATION=s3://xyz-mdm-artifacts/mlflow

# ─── S3 (Artifacts) ───────────────────────────────────────────────────────────
S3_ARTIFACT_BUCKET=xyz-mdm-artifacts
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:4566  # LocalStack only
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# ─── Feature Store ────────────────────────────────────────────────────────────
FEATURE_STORE_URL=http://localhost:8006

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_RETRAINING_TOPIC=mdm.retraining.triggers

# ─── Model Hyperparameters ────────────────────────────────────────────────────
TRANSFORMER_MODEL_NAME=bert-base-uncased
TRANSFORMER_LEARNING_RATE=2e-5
TRANSFORMER_BATCH_SIZE=64
TRANSFORMER_EPOCHS=3

GNN_HIDDEN_DIM=256
GNN_EPOCHS=100

XGB_N_ESTIMATORS=1000
XGB_MAX_DEPTH=8
XGB_LEARNING_RATE=0.05

ENSEMBLE_TRANSFORMER_WEIGHT=0.50
ENSEMBLE_GNN_WEIGHT=0.30
ENSEMBLE_XGB_WEIGHT=0.20

# ─── Evaluation Thresholds ────────────────────────────────────────────────────
MIN_F1_THRESHOLD=0.91
TARGET_F1_THRESHOLD=0.94
PROMOTION_F1_DELTA=0.005

# ─── Scheduling ───────────────────────────────────────────────────────────────
RETRAINING_SCHEDULE=0 2 * * 0
DRIFT_CHECK_INTERVAL_SECONDS=3600
