# ================================================================
# Model Training Pipeline Service — Base Configuration
# .env  (committed — no secrets)
#
# Config loads: .env → .env.local (later overrides earlier)
#
# IMPORTANT: ENVIRONMENT enum only accepts:
#   development | staging | production | test
#   (NOT "local" — use "development" for local dev)
#
# Git-ignored secret files:
#   .env.local       → local secrets
#   .env.dev         → dev (CI/CD injected)
#   .env.stg         → staging
#   .env.integration → integration
#   .env.prd         → production
# ================================================================

# Service Identity
SERVICE_NAME=model-training-pipeline
SERVICE_VERSION=3.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8110
API_WORKERS=1

# PostgreSQL — shared platform infra
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=xyzmdm
POSTGRES_USER=xyzmdm
POSTGRES_POOL_SIZE=10

# MLflow (optional — not in shared infra)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=xyz-mdm-matching
MLFLOW_ARTIFACT_LOCATION=s3://xyz-mdm-model-artifacts/mlflow

# S3 — LocalStack shared infra
S3_ARTIFACT_BUCKET=xyzmdm-model-artifacts
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:4566

# Feature Store — standardized port
FEATURE_STORE_URL=http://localhost:8115
FEATURE_STORE_TIMEOUT_SECONDS=30

# Kafka — shared platform infra
KAFKA_BROKERS=localhost:9092
KAFKA_RETRAINING_TOPIC=mdm.retraining.triggers
KAFKA_CONSUMER_GROUP=model-training-consumer

# Model Inference Service — standardized port
MODEL_INFERENCE_SERVICE_URL=http://localhost:8090

# Training Hyperparameters
TRANSFORMER_MODEL_NAME=bert-base-uncased
TRANSFORMER_LEARNING_RATE=2e-5
TRANSFORMER_BATCH_SIZE=64
TRANSFORMER_EPOCHS=3

GNN_HIDDEN_DIM=256
GNN_EPOCHS=100

XGB_N_ESTIMATORS=1000
XGB_MAX_DEPTH=8
XGB_LEARNING_RATE=0.05

ENSEMBLE_TRANSFORMER_WEIGHT=0.50
ENSEMBLE_GNN_WEIGHT=0.30
ENSEMBLE_XGB_WEIGHT=0.20

# Evaluation Thresholds
MIN_F1_THRESHOLD=0.91
TARGET_F1_THRESHOLD=0.94
PROMOTION_F1_DELTA=0.005

# Scheduling
RETRAINING_SCHEDULE=0 2 * * 0
DRIFT_CHECK_INTERVAL_SECONDS=3600