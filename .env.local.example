# ================================================================
# Model Training Pipeline Service — Local Secrets Example
# .env.local.example  (committed)
#
# Copy to .env.local:
#   cp .env.local.example .env.local
#
# Prerequisites:
#   1. Platform infra running (PostgreSQL, Kafka, LocalStack):
#        cd C:\XYZFusion\platform\docker
#        docker compose -f docker-compose.infra.yml up -d
#
#   2. Feature Store running:
#        cd ..\xyz-feature-store-service && make run-local
#
#   3. Install dependencies:
#        pip install -e ".[dev]"
#
#   4. Run Alembic migrations:
#        set POSTGRES_PASSWORD=xyzmdm_local_secret
#        alembic upgrade head
#
#   5. Run: make run-local
#
# NOTE: MLflow is optional. Without it, experiments won't be tracked.
# NOTE: First install downloads torch, transformers, torch-geometric (~3GB).
# ================================================================

ENVIRONMENT=development
LOG_LEVEL=DEBUG

# PostgreSQL password — shared platform infra
POSTGRES_PASSWORD=<YOUR_POSTGRES_PASSWORD>

# AWS LocalStack credentials (use test/test for local)
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
